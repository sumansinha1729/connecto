# The Connecto server. Leave empty in development: the panel then uses port 4050 on the same
# computer it was opened from (works on your Mac and from a phone on the same Wi-Fi/hotspot).
# Set it for production builds, e.g. VITE_API_URL=https://api.yourdomain.in
VITE_API_URL=

# Login: Firebase Phone Auth (Google sends the SMS). Firebase console → Project settings →
# Your apps → Web app. Without these the panel uses the server's dev codes (local testing only).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Set to "dev" to use the dev codes even when Firebase is set up
VITE_LOGIN=
