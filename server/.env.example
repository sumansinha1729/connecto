NODE_ENV=development
PORT=4050
# debug | info | warn | error (default: info in production, debug otherwise)
LOG_LEVEL=
# Requests per minute per signed-in user (or per IP when signed out) across the API
API_RATE_LIMIT_PER_MIN=300

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/connecto

# Allowed browser origins in production, comma-separated (any origin is allowed in development)
CORS_ORIGINS=

# Auth: generate a secret with `openssl rand -hex 48` (production requires 64+ characters)
JWT_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# OTP (codes are printed to the server console until a real SMS provider is added)
OTP_TTL_SEC=300
OTP_RESEND_SEC=30
OTP_MAX_PER_WINDOW=3
OTP_WINDOW_SEC=600
OTP_MAX_ATTEMPTS=5
# Per-IP limit (generous: many Indian mobile users share one IP)
OTP_IP_MAX_PER_WINDOW=50
# Accepted for every phone number outside production. Leave empty to disable.
DEV_OTP=123456

# Coins
SIGNUP_BONUS_COINS=50
CALL_RATE_COINS_PER_MIN=10

# Listener earnings in paise (100 paise = ₹1): ₹2.00/min, payouts from ₹500, weekly
LISTENER_EARNING_PAISE_PER_MIN=200
PAYOUT_MIN_PAISE=50000
PAYOUT_SCHEDULE=weekly

# Listener voice intro length (seconds)
VOICE_INTRO_MIN_SEC=30
VOICE_INTRO_MAX_SEC=60

# Calls & rooms
CALL_RING_TIMEOUT_SEC=30
PRESENCE_GRACE_SEC=15
ROOM_MAX_PARTICIPANTS=200

# Agora voice: https://console.agora.io → project with "App ID + Token" auth
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Voice token lifetime; the app renews tokens while a call or room is still on
AGORA_TOKEN_TTL_SEC=600

# File storage for voice intros: "local" saves into STORAGE_DIR (S3 comes later)
STORAGE_DRIVER=local
STORAGE_DIR=uploads
# Public URL of this server (used in links to stored files)
PUBLIC_BASE_URL=http://localhost:4050
