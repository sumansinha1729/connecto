NODE_ENV=development
PORT=4050

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/connecto

# Allowed browser origins in production, comma-separated (any origin is allowed in development)
CORS_ORIGINS=

# Auth: generate a secret with `openssl rand -hex 32`
JWT_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30

# OTP (codes are printed to the server console until a real SMS provider is added)
OTP_TTL_SEC=300
OTP_RESEND_SEC=30
OTP_MAX_PER_WINDOW=3
OTP_WINDOW_SEC=600
OTP_MAX_ATTEMPTS=5
# Per-IP limit (generous: many Indian mobile users share one IP)
OTP_IP_MAX_PER_WINDOW=50
# Accepted for every phone number outside production. Leave empty to disable.
DEV_OTP=123456

# Coins
SIGNUP_BONUS_COINS=50
CALL_RATE_COINS_PER_MIN=10
LISTENER_SHARE_PERCENT=50

# Calls & rooms
CALL_RING_TIMEOUT_SEC=30
PRESENCE_GRACE_SEC=15
ROOM_MAX_PARTICIPANTS=200
# Users must be approved by an admin before they can become listeners
LISTENER_APPROVAL_REQUIRED=true

# Agora voice: https://console.agora.io → project with "App ID + Token" auth
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL_SEC=3600
