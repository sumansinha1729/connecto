# Backend URL. Browser / iOS simulator: http://localhost:4050 · Android emulator: http://10.0.2.2:4050
# Real phone on the same Wi-Fi: http://<your-mac-ip>:4050
EXPO_PUBLIC_API_URL=http://localhost:4050


# Admin web panel (admin/ folder). Admin numbers that open the app see a link to it.
EXPO_PUBLIC_ADMIN_URL=http://localhost:5180

# Login: Firebase Phone Auth (Google sends the SMS).
# Android: put google-services.json in this folder and make a new build (see app.config.js).
# Browser: the four values below, from Firebase console → Project settings → Your apps → Web app.
# Without Firebase the app uses the server's dev codes (local testing only).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Set to "dev" to use the dev codes even when Firebase is set up (e.g. for the seeded test accounts)
EXPO_PUBLIC_LOGIN=
